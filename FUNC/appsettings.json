{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "FUNC.Controllers.GoalController": "Information",
        "FUNC.NodeUpdater": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "cluster1",
        "Match": {
          "Path": "/v2/{**catch-all}"
        }
      },
      "route2": {
        "ClusterId": "cluster1",
        "Match": {
          "Path": "/debug/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster1": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost"
          }
        }
      }
    }
  }
}
