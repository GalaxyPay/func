<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>func.api</string>
        <key>Program</key>
        <string>/opt/func/FUNC</string>
        <key>WorkingDirectory</key>
        <string>/opt/func</string>
        <key>RunAtLoad</key>
        <true/>
        <!-- Restart after a crash or failed start (e.g. a port still held); a clean exit stays down. -->
        <key>KeepAlive</key>
        <dict>
            <key>SuccessfulExit</key>
            <false/>
        </dict>
    </dict>
</plist>
