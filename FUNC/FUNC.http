@FUNC_HostAddress = http://localhost:3536
# Session token from POST {{FUNC_HostAddress}}/auth/login {"password": "..."}
@FUNC_Token = paste-session-token-here

### Support diagnostics (no session needed from the node machine itself)
GET {{FUNC_HostAddress}}/func/diagnostics
Accept: application/json

### GOAL
GET {{FUNC_HostAddress}}/goal/version
Accept: application/text
Authorization: Bearer {{FUNC_Token}}

### ALGORAND
GET {{FUNC_HostAddress}}/algorand/
Accept: application/json

### Algorand node health (range: 1h, 24h, 7d or 30d)
GET {{FUNC_HostAddress}}/algorand/health?range=1h
Accept: application/json
Authorization: Bearer {{FUNC_Token}}

### Search the Algorand node log, newest first (level: info, warning or error)
GET {{FUNC_HostAddress}}/algorand/log?level=warning&q=&limit=50
Accept: application/json
Authorization: Bearer {{FUNC_Token}}

### Create Algorand
POST {{FUNC_HostAddress}}/algorand
Accept: application/text

### Start Algorand
PUT {{FUNC_HostAddress}}/algorand/start
Accept: application/text

### Stop Algorand
PUT {{FUNC_HostAddress}}/algorand/stop
Accept: application/text

### Delete Algorand
DELETE {{FUNC_HostAddress}}/algorand
Accept: application/text

### VOI
GET {{FUNC_HostAddress}}/voi/
Accept: application/json

### Create Voi
POST {{FUNC_HostAddress}}/voi
Accept: application/text

### Start Voi
PUT {{FUNC_HostAddress}}/voi/start
Accept: application/text

### Stop Voi
PUT {{FUNC_HostAddress}}/voi/stop
Accept: application/text

### Delete Voi
DELETE {{FUNC_HostAddress}}/voi
Accept: application/text
